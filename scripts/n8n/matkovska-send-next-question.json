    {
      "id": "896a8aa0-73a7-457d-a9fc-212da305fe82",
      "name": "Determine Content Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        0
      ],
      "parameters": {
        "jsCode": "const j = $json;\nconst contentType = j.content_pref === 'both' ? (Math.random() < 0.5 ? 'vocab' : 'grammar') : j.content_pref;\nreturn [{ json: { ...j, contentType } }];"
      }
    },
    {
