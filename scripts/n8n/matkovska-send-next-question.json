    {
      "id": "5ab3c7f1-3893-4094-913b-28ea66a9826a",
      "name": "Build Question Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        160
      ],
      "parameters": {
        "jsCode": "const j = $('When Called').item.json;\nconst d = $json;\nlet opts, qText;\nif (d.question_id !== undefined) {\n  opts = d.options.map((t, i) => ({ text: t, cb: i === d.correct_option_index ? `qz_correct_grammar_${d.question_id}` : `qz_wrong_grammar_${d.question_id}` }));\n  qText = d.sentence;\n} else {\n  opts = [{ text: d.correct, cb: `qz_correct_vocab_${d.word_id}` }, ...d.distractors.map((t) => ({ text: t, cb: `qz_wrong_vocab_${d.word_id}` }))];\n  qText = `What does \"${d.word}\" mean?`;\n}\nfor (let i = opts.length - 1; i > 0; i--) {\n  const k = Math.floor(Math.random() * (i + 1));\n  [opts[i], opts[k]] = [opts[k], opts[i]];\n}\nconst buttons = opts.map((o) => [{ text: o.text, callback_data: o.cb }]);\nreturn [{ json: { chat_id: j.chat_id, text: `Question ${j.question_index} of 3\\n\\n${qText}`, buttons } }];"
      }
    },
    {
      "id": "79cecafd-e8c0-47e8-a1c8-6b6127bc163d",
      "name": "Reply: Question",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1504,
        160
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ \"https://api.telegram.org/bot\" + $env.TELEGRAM_MATKOVSKA_BOT_TOKEN + \"/sendMessage\" }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: Number($json.chat_id), text: $json.text, reply_markup: { inline_keyboard: $json.buttons } }) }}",
        "options": {}
      }
    },
    {
      "id": "7c70db02-2969-419d-807c-e5c31f62b17f",
      "name": "Delete Session (Exhausted)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1264,
        -144
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM matkovska_quiz_bot.sessions WHERE chat_id = $1",
        "options": {
          "queryReplacement": "={{ Number($('When Called').item.json.chat_id) }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "Pfck0EZrKZMEBgFo",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "7c54e125-c068-4047-86fc-3546835e6478",
      "name": "Build Exhausted Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1504,
        -144
      ],
      "parameters": {
        "jsCode": "const j = $('When Called').item.json;\nconst text = j.question_index > 1\n  ? `🏁 Round ended early: ${j.correct_count}/${j.question_index - 1}`\n  : 'No questions available right now — try again later.';\nreturn [{ json: { chat_id: j.chat_id, text } }];"
      }
    },
