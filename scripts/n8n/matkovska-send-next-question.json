        "url": "={{ \"https://api.telegram.org/bot\" + $env.TELEGRAM_MATKOVSKA_BOT_TOKEN + \"/sendMessage\" }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: Number($json.chat_id), text: $json.text }) }}",
        "options": {}
      }
    },
