      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "{{ 'SELECT question_id, sentence, options, correct_option_index FROM matkovska_quiz_bot.pick_next_grammar_question(p_chat_id := ' + Number($json.chat_id) + ', p_exclude_ids := ARRAY[' + ($json.asked_grammar_ids || []).map(Number).join(',') + ']::bigint[])' }}",
        "options": {}
      },
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "Pfck0EZrKZMEBgFo",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "8048d256-d1cc-4826-a869-ac5ae16e8533",
      "name": "Question Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1008,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
